# Environment
NODE_ENV=production

# Server Configuration
PORT=5000

# Database (use MongoDB Atlas or production instance)
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/ecommerce?retryWrites=true&w=majority

# JWT Configuration (MUST use strong random strings in production)
JWT_SECRET=production-secret-key-use-strong-random-string
JWT_REFRESH_SECRET=production-refresh-secret-use-strong-random-string
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=your-production-razorpay-key-id
RAZORPAY_KEY_SECRET=your-production-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-production-razorpay-webhook-secret

# Cloud Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=your-production-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-production-cloudinary-api-key
CLOUDINARY_API_SECRET=your-production-cloudinary-api-secret

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-production-email@gmail.com
SMTP_PASS=your-production-app-password
EMAIL_FROM=noreply@yourdomain.com

# Frontend URL
CLIENT_URL=https://yourdomain.com

# Redis (recommended for production)
REDIS_URL=redis://your-redis-host:6379

# Sentry (for error tracking)
SENTRY_DSN=your-production-sentry-dsn
