# Environment
NODE_ENV=test

# Server Configuration
PORT=5001

# Database (test database)
MONGO_URI=mongodb://localhost:27017/ecommerce-test
MONGO_TEST_URI=mongodb://localhost:27017/ecommerce-test

# JWT Configuration
JWT_SECRET=test-secret-key
JWT_REFRESH_SECRET=test-refresh-secret-key
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# Payment Gateway (test credentials)
RAZORPAY_KEY_ID=test-razorpay-key-id
RAZORPAY_KEY_SECRET=test-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=test-razorpay-webhook-secret

# Cloud Storage (test credentials)
CLOUDINARY_CLOUD_NAME=test-cloudinary-cloud-name
CLOUDINARY_API_KEY=test-cloudinary-api-key
CLOUDINARY_API_SECRET=test-cloudinary-api-secret

# Email Configuration (test)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=test@gmail.com
SMTP_PASS=test-password
EMAIL_FROM=test@ecommerce.com

# Frontend URL
CLIENT_URL=http://localhost:3000

# Redis (optional)
REDIS_URL=redis://localhost:6379

# Sentry (disabled for tests)
SENTRY_DSN=
